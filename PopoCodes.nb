                    RowBox[{"Xm", "[", 
                    RowBox[{"k", ",", "l_"}], "]"}]}], "\[RuleDelayed]", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"++", 
                    RowBox[{
