Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Rot", "[", 
    RowBox[{"{", 
     RowBox[{"X_", ",", "\[CurlyPhi]_"}], "}"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{"X", ",", "\[CurlyPhi]"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Rot", "[", "pd_PD", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "n", ",", "xs", ",", "x", ",", "rots", ",", "Xp", ",", "Xm", ",", 
       RowBox[{"front", "=", 
        RowBox[{"{", "1", "}"}]}], ",", "k"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"n", "=", 
       RowBox[{"Length", "@", "pd"}]}], ";", 
      RowBox[{"rots", "=", 
       RowBox[{"Table", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"2", "n"}], "+", "1"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"xs", "=", 
       RowBox[{"Cases", "[", 
        RowBox[{"pd", ",", 
         RowBox[{"x_X", "\[RuleDelayed]", 
          RowBox[{"\[Piecewise]", GridBox[{
             {
              RowBox[{"Xp", "[", 
               RowBox[{
                RowBox[{
                "x", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}], 
                ",", 
                RowBox[{
                "x", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}],
                "]"}], 
              RowBox[{"PositiveQ", "@", "x"}]},
             {
              RowBox[{"Xm", "[", 
               RowBox[{
                RowBox[{
                "x", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
                ",", 
                RowBox[{
                "x", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}],
                "]"}], "True"}
            }]}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"k", "=", "1"}], ",", 
        RowBox[{"k", "<=", 
         RowBox[{"2", "n"}]}], ",", 
        RowBox[{"++", "k"}], ",", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"FreeQ", "[", 
           RowBox[{"front", ",", 
            RowBox[{"-", "k"}]}], "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"front", "=", 
           RowBox[{"Flatten", "@", 
            RowBox[{"Replace", "[", 
             RowBox[{"front", ",", 
              RowBox[{"k", "\[Rule]", 
               RowBox[{"(", 
                RowBox[{"xs", "/.", 
                 RowBox[{"{", "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"Xp", "[", 
                    RowBox[{"k", ",", "l_"}], "]"}], "|", 
                    RowBox[{"Xm", "[", 
                    RowBox[{"l_", ",", "k"}], "]"}]}], "\[RuleDelayed]", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"l", "+", "1"}], ",", 
                    RowBox[{"k", "+", "1"}], ",", 
                    RowBox[{"-", "l"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Xp", "[", 
                    RowBox[{"l_", ",", "k"}], "]"}], "|", 
                    RowBox[{"Xm", "[", 
                    RowBox[{"k", ",", "l_"}], "]"}]}], "\[RuleDelayed]", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"++", 
                    RowBox[{
                    "rots", "\[LeftDoubleBracket]", "l", 
                    "\[RightDoubleBracket]"}]}], ";", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", "l"}], ",", 
                    RowBox[{"k", "+", "1"}], ",", 
                    RowBox[{"l", "+", "1"}]}], "}"}]}], ")"}]}], ",", 
                   "\[IndentingNewLine]", 
                   RowBox[{
                    RowBox[{"_Xp", "|", "_Xm"}], "\[RuleDelayed]", 
