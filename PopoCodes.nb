 RowBox[{
  RowBox[{
   RowBox[{"Rot", "[", "pd_PD", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", ",", "xs", ",", "x", ",", "rots", ",", "Xp", ",", "Xm", ",", 
       RowBox[{"front", "=", 
        RowBox[{"{", "1", "}"}]}], ",", "k"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"n", "=", 
       RowBox[{"Length", "@", "pd"}]}], ";", 
      RowBox[{"rots", "=", 
       RowBox[{"Table", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"2", "n"}], "+", "1"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"xs", "=", 
       RowBox[{"Cases", "[", 
        RowBox[{"pd", ",", 
